# Public (browser bundle). Safe to expose.
# Country code + number, digits only, no plus sign. Leave blank to fall back to /contact.
VITE_WHATSAPP_NUMBER=

# Public site address, with no trailing slash. Used for canonical links, Open Graph, JSON-LD and the sitemap.
# Netlify sets URL during builds, so the sitemap still works if this is left blank there.
VITE_SITE_URL=

# Added in the Shopify phase:
# VITE_SHOPIFY_DOMAIN=your-shop.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=
# VITE_SHOPIFY_API_VERSION=2026-07
# VITE_GA4_ID=
# VITE_META_PIXEL_ID=

# Server-only (Netlify environment variables, never prefixed VITE_). Added in the Shopify phase:
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# SHOPIFY_ADMIN_CLIENT_ID=
# SHOPIFY_ADMIN_CLIENT_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ADMIN_SESSION_SECRET=
# ADMIN_EMAIL_ALLOWLIST=
